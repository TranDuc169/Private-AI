DATABASE_URL=postgresql+psycopg://private_ai:local_dev_only@127.0.0.1:5432/private_ai
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Run: .venv\Scripts\python.exe setup_auth.py (creates secret in .env only)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
# PDF storage defaults to backend/storage (private; never served as static files).
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
MAX_PDF_CHARACTERS=2000000
PDF_TIMEOUT_SECONDS=30

# Week 5: local embedding model (1024 dimensions)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
MAX_DOCUMENT_CHUNKS=3000
